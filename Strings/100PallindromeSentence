class Solution {

    public boolean sentencePalindrome(String s) {
        // code here
        String str = s.toLowerCase().trim();
        
        StringBuilder org_str = new StringBuilder();
        for( int i = 0; i < str.length(); i++){
            if(Character.isLowerCase(str.charAt(i)) || Character.isDigit(str.charAt(i))){
                org_str.append(str.charAt(i));
            }
        }
        StringBuilder rev_str = new StringBuilder(org_str.toString());
        rev_str.reverse();
        return (org_str.toString().equals(rev_str.toString()));
    }
}
