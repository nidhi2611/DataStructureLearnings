class Solution {
    int longestPrefixSuffix(String s) {
        int lps[] = new int[s.length()];
        return calculatelps(lps,s);
    }
    public static int calculatelps( int []lps, String s){
        int len = 0;
        int i = 1;
        lps[0] = 0;
        
        while( i < s.length()){
            if(s.charAt(i) == s.charAt(len)){
                len++;
                lps[i] = len;
                i++;
            }else{
                if( len != 0 ){
                    len = lps[len -1];
                }else{
                    lps[i] = 0;
                    i++;
                }
            }
        }
        return lps[s.length()-1];
    }
}
